# ---------------------------------------------------------------------------
# OpsPilot AI — example environment file.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
#
# This file is the single source of truth for the configuration surface.
# Every variable below must be readable by `app.config.Settings`, and no
# code may read os.environ directly. See docs/architecture.md §14.
# ---------------------------------------------------------------------------

# --- Anthropic ---------------------------------------------------------------
# Required only for LLM-backed planning (OPSPILOT_PLANNER=llm).
# Get a key at https://console.anthropic.com/settings/keys
# When unset, OpsPilot automatically falls back to the deterministic
# rule-based planner so the whole system still runs end-to-end offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional override for proxies / gateways. Leave blank for the default API.
ANTHROPIC_BASE_URL=

# --- Agent behaviour ---------------------------------------------------------
# `auto` = use the LLM planner when ANTHROPIC_API_KEY is present, else rules.
# `llm`  = require the LLM planner (fails fast when the key is missing).
# `rules`= always use the deterministic rule-based planner.
OPSPILOT_PLANNER=auto

# Execution budgets. Every one of these is a hard stop; exhausting any of
# them terminates the run as `failed` with a budget_exhausted reason. These
# exist to make infinite loops structurally impossible (architecture.md §9).
OPSPILOT_MAX_RETRIES=2              # per step attempt retries (=> 3 attempts max)
OPSPILOT_MAX_REPLANS=2              # whole-plan revisions per run
OPSPILOT_MAX_STEPS=25               # executed steps per run
OPSPILOT_RUN_DEADLINE_SECONDS=300   # wall-clock budget for one run
OPSPILOT_RETRY_BASE_DELAY_MS=250    # exponential backoff base
OPSPILOT_RETRY_MAX_DELAY_MS=8000

# --- Integrations ------------------------------------------------------------
# `mock` is the only implemented adapter set and the only value that is safe
# today. `real` is reserved for future external systems and currently refuses
# to start. send_email_mock can never deliver mail in either mode.
OPSPILOT_INTEGRATIONS=mock
# Simulated failure rate for mock tools (0.0-1.0). Keep 0.0 for determinism;
# the evaluation suite injects failures explicitly instead.
OPSPILOT_TOOL_FAILURE_RATE=0.0
# Seed for all pseudo-random behaviour (mock latency, failure injection,
# generated ids). Fixed value => reproducible runs and evaluations.
OPSPILOT_SEED=1337

# --- Human-in-the-loop -------------------------------------------------------
# Pending approvals older than this expire; the paused run then terminates
# as `expired` rather than waiting forever on a human who never returns.
OPSPILOT_APPROVAL_TTL_SECONDS=86400

# --- Execution ownership (architecture.md §2.4, ADR-023) ---------------------
# A worker driving a run holds a lease on it and renews it on every
# heartbeat. If the process dies, the lease expires and the startup
# reconciler either resumes the run from its LangGraph checkpoint or marks
# it failed(orphaned). The interval must be at most half the TTL so one
# missed heartbeat never costs a healthy worker its run.
OPSPILOT_LEASE_TTL_SECONDS=30
OPSPILOT_HEARTBEAT_INTERVAL_SECONDS=10

# --- Database ----------------------------------------------------------------
# Async driver URL used by the API and Alembic.
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
# Used by docker-compose to initialise the Postgres container.
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=opspilot

# --- Backend -----------------------------------------------------------------
OPSPILOT_ENV=development            # development | test | production
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Largest tool input/output payload persisted to a trace event; larger
# payloads are truncated with a marker so traces cannot blow up the database.
OPSPILOT_TRACE_PAYLOAD_MAX_BYTES=16384

# --- Frontend ----------------------------------------------------------------
# Base URL of the OpsPilot API as seen from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
